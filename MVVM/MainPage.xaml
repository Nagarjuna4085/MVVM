<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MVVM.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center"
            >
            <Entry x:Name="FirstEntry" Placeholder="FirstName" TextChanged="FirstEntry_TextChanged"  />
            <Entry x:Name="LastEntry" Placeholder="LastName"  TextChanged="LastEntry_TextChanged" />

            <Label TextColor="White" x:Name="LabelFullName" />
            <Button x:Name="ClickButton" Clicked="ClickButton_Clicked" Text="Click Me!!" HorizontalOptions="Center" />


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
